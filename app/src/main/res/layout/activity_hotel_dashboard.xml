<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F3F6FA">

    <TextView
        android:id="@+id/tvHotelName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hotel Dashboard"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#B85C24"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnAddFood"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Food Item"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnViewMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View My Menu"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnSetSpecial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Set Daily Special"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Logout"
        android:layout_marginTop="24dp" />

</LinearLayout>